# Do NOT put real values in a file on GitHub.
# Paste these into Streamlit Cloud: App > Settings > Secrets
KOBO_SERVER = "https://kf.kobotoolbox.org"   # or https://eu.kobotoolbox.org if your account is on the EU server
KOBO_TOKEN = "paste-your-kobo-api-key"
KOBO_ASSET_UID = "paste-form-uid"            # the code in the form's URL: .../#/forms/<UID>/summary
DOALF_PASSWORD = "choose-a-strong-password"  # full access, includes farmer names and phones
KEFRI_PASSWORD = "choose-another-password"   # totals only, no personal data
